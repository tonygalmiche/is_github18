<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- is.github.pr - Vue formulaire -->
    <record id="is_github_pr_form" model="ir.ui.view">
        <field name="name">is.github.pr.form</field>
        <field name="model">is.github.pr</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_actualiser" string="Actualiser" type="object" class="oe_highlight"/>
                    <field name="action" widget="statusbar" statusbar_visible="analyse,a_faire,fait,abandonne" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="number" readonly="1"/>
                            <field name="url" widget="url" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="compte_id" readonly="1"/>
                            <field name="repository_id" readonly="1"/>
                            <field name="branch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="contributor_id" readonly="1"/>
                            <field name="module_ids" widget="many2many_tags" readonly="1"/>
                            <field name="needs_review" readonly="1"/>
                            <field name="draft" readonly="1"/>
                            <field name="labels" readonly="1"/>
                            <field name="github_created_at" readonly="1"/>
                            <field name="github_updated_at" readonly="1"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Commentaire">
                        <field name="commentaire"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- is.github.pr - Vue liste -->
    <record id="is_github_pr_list" model="ir.ui.view">
        <field name="name">is.github.pr.list</field>
        <field name="model">is.github.pr</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_actualiser_selection" string="Actualiser" type="object" class="oe_highlight" icon="fa-refresh"/>
                </header>
                <field name="compte_id"          optional="show"/>
                <field name="repository_id"      optional="show"/>
                <field name="number"             optional="show"/>

                <button name="action_set_abandonne" type="object" icon="fa-times" class="text-danger"
                        title="Abandonner" invisible="action == 'abandonne'"/>

                <field name="name"               optional="show"/>
                <field name="branch_id"          optional="show"/>
                <field name="module_ids"         optional="hide" widget="many2many_tags"/>
                <field name="contributor_id"     optional="show"/>
                <field name="state"              optional="show" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'merged'"
                       decoration-danger="state == 'closed'"/>
                <field name="action"              optional="show" widget="badge"
                       decoration-warning="action == 'analyse'"
                       decoration-danger="action == 'a_faire'"
                       decoration-success="action == 'fait'"
                       decoration-muted="action == 'abandonne'"/>
                <field name="needs_review"       optional="show"/>
                <field name="draft"              optional="hide"/>
                <field name="labels"             optional="hide"/>
                <field name="github_created_at"  optional="show"/>
                <field name="github_updated_at"  optional="show"/>
                <field name="last_sync_date"     optional="hide"/>
                <field name="url"                optional="hide" widget="url"/>
                <field name="commentaire"        optional="hide"/>
                <field name="write_date"         optional="hide"/>
            </list>
        </field>
    </record>

    <!-- is.github.pr - Vue recherche -->
    <record id="is_github_pr_search" model="ir.ui.view">
        <field name="name">is.github.pr.search</field>
        <field name="model">is.github.pr</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="action"/>
                <field name="state"/>
                <field name="number"/>
                <field name="compte_id"/>
                <field name="repository_id"/>
                <field name="branch_id"/>
                <field name="module_ids"/>
                <field name="contributor_id"/>
                <filter name="needs_review" string="Needs review" domain="[('needs_review', '=', True), ('action', '!=', 'abandonne')]"/>
                <filter name="is_mig"       string="[MIG]"        domain="[('name', 'ilike', '[MIG]'), ('action', '!=', 'abandonne')]"/>
                <filter name="is_not_mig"   string="&lt;&gt;[MIG]"    domain="[('name', 'not ilike', '[MIG]'), ('action', '!=', 'abandonne')]"/>
                <filter name="state_open"   string="Ouvertes"      domain="[('state', '=', 'open'), ('action', '!=', 'abandonne')]"/>
                <filter name="state_merged" string="Fusionnées"    domain="[('state', '=', 'merged'), ('action', '!=', 'abandonne')]"/>
                <filter name="state_closed" string="Fermées"       domain="[('state', '=', 'closed'), ('action', '!=', 'abandonne')]"/>
                <filter name="not_abandonne" string="Non abandonnées" domain="[('action', '!=', 'abandonne')]"/>
                <filter name="action_a_faire" string="A Faire" domain="[('action', '=', 'a_faire')]"/>
                <filter name="action_fait"    string="Fait" domain="[('action', '=', 'fait')]"/>
                <group expand="0" string="Regrouper par...">
                    <filter name="group_by_compte"      string="Compte"        context="{'group_by': 'compte_id'}"/>
                    <filter name="group_by_repository"  string="Dépôt"         context="{'group_by': 'repository_id'}"/>
                    <filter name="group_by_branch"      string="Branche"       context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_contributor" string="Contributeur"  context="{'group_by': 'contributor_id'}"/>
                    <filter name="group_by_state"       string="État"         context="{'group_by': 'state'}"/>
                    <filter name="group_by_action"      string="Action"       context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Pull Requests -->
    <record id="is_github_pr_action" model="ir.actions.act_window">
        <field name="name">Pull Requests Github</field>
        <field name="res_model">is.github.pr</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_abandonne': 1}</field>
    </record>

    <!-- Action serveur : actualiser en masse -->
    <record id="is_github_pr_action_actualiser" model="ir.actions.server">
        <field name="name">Actualiser</field>
        <field name="model_id" ref="model_is_github_pr"/>
        <field name="binding_model_id" ref="model_is_github_pr"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_actualiser_selection()</field>
    </record>

    <!-- is.github.pr.import - Vue formulaire -->
    <record id="is_github_pr_import_form" model="ir.ui.view">
        <field name="name">is.github.pr.import.form</field>
        <field name="model">is.github.pr.import</field>
        <field name="arch" type="xml">
            <form string="Recherche / import de Pull Requests">
                <header>
                    <button name="action_fetch" string="Rechercher / Mettre à jour" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="compte_ids" widget="many2many_tags"/>
                            <field name="branch_id"/>
                            <field name="module_ids" widget="many2many_tags"/>
                            <field name="contributor_id"/>
                            <field name="title_filter"/>
                        </group>
                        <group>
                            <field name="needs_review"/>
                            <field name="state"/>
                            <field name="limit"/>
                            <field name="last_run_date"/>
                            <field name="last_created"/>
                            <field name="last_updated"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- is.github.pr.import - Vue liste -->
    <record id="is_github_pr_import_list" model="ir.ui.view">
        <field name="name">is.github.pr.import.list</field>
        <field name="model">is.github.pr.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"          optional="show"/>
                <field name="compte_ids"    optional="show" widget="many2many_tags"/>
                <field name="branch_id"     optional="show"/>
                <field name="module_ids"    optional="hide" widget="many2many_tags"/>
                <field name="contributor_id" optional="hide"/>
                <field name="needs_review"  optional="show"/>
                <field name="state"         optional="show"/>
                <field name="last_run_date" optional="show"/>
                <field name="last_created"  optional="show"/>
                <field name="last_updated"  optional="show"/>
            </list>
        </field>
    </record>

    <!-- Action recherche / import PR -->
    <record id="is_github_pr_import_action" model="ir.actions.act_window">
        <field name="name">Rechercher / mettre à jour des Pull Requests</field>
        <field name="res_model">is.github.pr.import</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
